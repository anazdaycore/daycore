# ── Daycore v2 environment ──────────────────────────────────────────────────
# Copy to .env and adjust. Real environment variables always override .env.

# Server
APP_ENV=development            # development | production
# listen interface; empty = all. Behind nginx use 127.0.0.1
HOST=
PORT=8080
# Frontend build served by Go at "/" (SPA fallback). Missing dir = API-only
# (e.g. during `npm run dev`, which proxies /api to this server instead).
STATIC_DIR=web/frontend/dist
PUBLIC_BASE_URL=http://localhost:8080   # set to https://your.domain in production (OAuth callbacks)
# Comma-separated CORS allowlist for a separately-hosted frontend (dev only).
# Leave empty when nginx serves the frontend same-origin.
ALLOWED_ORIGINS=
# Cookie SameSite: lax | strict | none. "none" is for a frontend on a different
# site than the API and REQUIRES SECURE_COOKIES=true (checked at boot).
COOKIE_SAMESITE=lax

# ── Writable state ──────────────────────────────────────────────────────────
# DATA_DIR is the one directory the server writes to besides the database.
# Empty = the file bus is off, and every feature that needs bytes says so
# rather than half-working.
DATA_DIR=
# BLOB_STORE selects the registered file-bus driver. Empty with DATA_DIR set
# means localfs. Object stores land here as they are implemented.
BLOB_STORE=
# Prompt templates on disk, seeding the database copies. Empty = compiled-in.
PROMPTS_DIR=

# ── Language ────────────────────────────────────────────────────────────────
# Each USER picks their own two languages on the settings page — one main, one
# to fall back on — and every frontend's home page switches between those two.
# These are only the DEFAULTS for someone who has not chosen yet; they do not
# restrict what anyone may pick. A bad value fails the boot rather than silently
# starting every new user in the wrong language.
DEFAULT_PRIMARY_LOCALE=zh-CN
# Leave empty to start users with no switch; they can still add a second later.
DEFAULT_SECONDARY_LOCALE=en-US
# Message packs: <locale>.json files, flat {"key": "text"}. Dropping one in adds
# a language WITHOUT a rebuild — only zh-CN and en-US are compiled in, and they
# are a floor, not the set of languages supported. Resolution is
# database → these files → compiled-in. Export a starting point for a new
# translation from the admin console.
LOCALES_DIR=locales

# ── Database ────────────────────────────────────────────────────────────────
# DB_TYPE selects the registered driver: sqlite | postgres | mysql | mongodb
DB_TYPE=sqlite
# SQLite (default — zero external services, single-file deploy):
DB_DSN=file:daycore.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)
# PostgreSQL:  DB_DSN=postgres://user:pass@localhost:5432/daycore?sslmode=disable
# MySQL:       DB_DSN=user:pass@tcp(localhost:3306)/daycore?charset=utf8mb4&parseTime=true
# The server appends the connection settings it depends on if you leave them out
# — clientFoundRows=true on MySQL, busy_timeout + WAL on SQLite. You do not have
# to copy them; you cannot break them by forgetting them.
# MongoDB:     DB_DSN=mongodb://localhost:27017/daycore

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate strong values in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=
COOKIE_SECRET=
# optional extra server-side secret for hashing. ⚠️ Changing it later invalidates
# every existing password hash.
PASSWORD_PEPPER=
JWT_TTL=720h
SECURE_COOKIES=false           # true behind HTTPS / in production

# ── AI ──────────────────────────────────────────────────────────────────────
MODELS_CONFIG=config/models.yaml
OAUTH_CONFIG=config/oauth.yaml
PROVIDERS_CONFIG=config/providers.yaml   # weather/search/channels capability sources
# extra theme value kinds (JSON dir; optional)
THEME_KINDS_DIR=
# These name an `id` in models.yaml — OUR stable name for a catalog entry, not a
# vendor model name. Vendors retire their names; the id/model split in
# models.yaml is what keeps that from reaching your .env.
DEFAULT_CHAT_MODEL=chat            # must match an id in models.yaml
# empty = first vision-capable model in the catalog
DEFAULT_VISION_MODEL=
# e.g. `planner` (thinking model); empty = chat model
DEFAULT_PLANNER_MODEL=
AI_REQUEST_TIMEOUT=120s
AGENT_MAX_ROUNDS=6                 # companion agent tool rounds per message

# API keys referenced by models.yaml (api_key_env):
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web search for the companion agent (optional; falls back to DuckDuckGo):
TAVILY_API_KEY=

# ── Limits / admin ──────────────────────────────────────────────────────────
AI_RATE_LIMIT_PER_MIN=30
AUTH_RATE_LIMIT_PER_MIN=10      # login/register attempts per IP per minute
MAX_IMAGE_BYTES=8388608
MAX_UPLOAD_BYTES=25165824         # POST /api/files cap (24 MiB)
# REQUIRED in production (boot refuses without it). In development one is
# generated and printed at startup; the old "empty = open" branch is gone.
ADMIN_TOKEN=

# Set true ONLY when behind a trusted reverse proxy (nginx): rate limits and
# logs then key on X-Forwarded-For. Left false, XFF is ignored; set true on a
# directly exposed server, a client can spoof XFF and dodge per-IP limits.
TRUST_PROXY_HEADERS=false

# ── Autonomous planning ─────────────────────────────────────────────────────
AUTO_PLAN_MAX_DAYS=7            # largest date range one /api/ai/auto-plan call covers
ASSIGNMENT_LOOKAHEAD_DAYS=14    # how far ahead assignments count as "upcoming" in AI context

# ── Weather ─────────────────────────────────────────────────────────────────
# Providers chain in order; a failing one falls through to the next.
WEATHER_PROVIDER=open-meteo     # open-meteo | qweather | openweathermap | wttr.in
QWEATHER_API_KEY=
OPENWEATHERMAP_API_KEY=

# ── Messaging channels ──────────────────────────────────────────────────────
# QQ via OneBot 11 (napcat and friends), forward WebSocket. Empty = no channel;
# the background worker still runs, it just persists proactive output instead
# of pushing it.
ONEBOT_WS_URL=
ONEBOT_TOKEN=

# ── Background worker ───────────────────────────────────────────────────────
# IANA timezone the proactive briefs are scheduled in. Global for now —
# sessions do not carry a timezone yet, and the brief's weather lookup is
# still hardcoded to Beijing (docs/ROADMAP.md, known gaps).
WORKER_DEFAULT_TZ=Asia/Shanghai
